# ============================================================
# easyQuant 环境变量配置
# ============================================================
# 使用方法:
#   1. 复制此文件为 .env: cp .env.example .env
#   2. 根据实际环境修改配置
#   3. 启动服务
# ============================================================

# ------------------------------------------------------------
# 项目基础配置
# ------------------------------------------------------------
PROJECT_NAME=easyQuant API
PROJECT_DESCRIPTION=easyQuant Backend API
VERSION=0.1.0
API_V1_STR=/api/v1

# ------------------------------------------------------------
# 跨域配置
# ------------------------------------------------------------
# JSON 数组格式，允许的前端域名
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ------------------------------------------------------------
# 安全配置 (必需)
# ------------------------------------------------------------
# JWT 签名密钥 - 生产环境必须修改！
# 建议使用: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------
# 数据库配置 (必需)
# ------------------------------------------------------------
# PostgreSQL 连接字符串
# 格式: postgresql+asyncpg://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/easyquant

# ------------------------------------------------------------
# Redis 配置 (可选)
# ------------------------------------------------------------
# Redis 连接字符串，用于缓存
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# AKShare 限流配置 (可选)
# ------------------------------------------------------------
# 每秒请求数 (QPS)，默认 0.5 即 2 秒 1 次
AKSHARE_RATE_LIMIT_QPS=0.5
# 突发请求数，默认 3
AKSHARE_RATE_LIMIT_BURST=3
# 重试最大次数
AKSHARE_RETRY_MAX_ATTEMPTS=3
# 重试基础延迟 (秒)
AKSHARE_RETRY_BASE_DELAY=2.0
# 重试最大延迟 (秒)
AKSHARE_RETRY_MAX_DELAY=120.0

# ------------------------------------------------------------
# 调试模式
# ------------------------------------------------------------
# true: 开发模式，显示详细日志
# false: 生产模式，启用严格验证
DEBUG=false
